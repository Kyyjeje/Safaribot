const fetch = require('node-fetch');
const FormData = require('form-data');
const sharp = require('sharp');
const axios = require('axios');
const { fromBuffer } = require('file-type');
require('../../settings');

async function UguuUpload(buffer) {
    const { ext } = await fromBuffer(buffer);
    const form = new FormData();
    form.append('files[]', buffer, { filename: `upload.${ext}` });
    const { data } = await axios.post('https://uguu.se/upload.php', form, {
        headers: form.getHeaders(),
        timeout: 15000
    });
    if (!data.files || !data.files[0]) throw new Error('Upload ke Uguu.se gagal');
    return data.files[0].url;
}

async function validateAndResizeImage(buffer) {
    const { width, height, format } = await sharp(buffer).metadata();
    if (!['jpeg', 'png', 'jpg'].includes(format)) throw new Error('Format gambar tidak didukung');
    if (width < 256 || height < 256) return await sharp(buffer).resize({ width: 256, height: 256, fit: 'inside' }).toBuffer();
    if (width > 5760 || height > 3240) return await sharp(buffer).resize({ width: 5760, height: 3240, fit: 'inside' }).toBuffer();
    return buffer;
}

module.exports = {
    name: 'upscale',
    alias: ['upscaleimage', '.upscale'],
    run: async ({ naze, m }) => {
        const mediaMessage = m.quoted ? m.quoted : m;
        const mime = (mediaMessage.msg || mediaMessage).mimetype || '';
        if (!/image\/(jpe?g|png)/.test(mime)) return m.reply(`Kirim/reply gambar (JPEG/PNG) dengan *${m.prefix + m.command}*!`);

        
        try {
            const media = await mediaMessage.download();
            const validatedImgData = await validateAndResizeImage(media);
            const imageUrl = await UguuUpload(validatedImgData);
            const upscaleUrl = `https://api.siputzx.my.id/api/iloveimg/upscale?image=${encodeURIComponent(imageUrl)}&scale=4`;
            const response = await fetch(upscaleUrl, {
                method: 'GET',
                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36' },
                timeout: 15000
            });
            if (!response.ok) throw new Error(`HTTP error: ${response.status}`);
            const imageBuffer = await response.buffer();
            const { format } = await sharp(imageBuffer).metadata();
            if (!['jpeg', 'png', 'jpg'].includes(format)) throw new Error('Format hasil upscale tidak valid');
            await naze.sendMessage(m.chat, { image: imageBuffer, caption: '✅ Gambar berhasil di-upscale!' }, { quoted: m });
            
        } catch (e) {
            
            await global.sendMessageWithThumbnail(naze, m.chat, 'eror', m);
            await global.handleError(naze, m, e, { sendRawError: true, useGemini: true });
        }
    }
};